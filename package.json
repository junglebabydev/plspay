{
  "name": "plspay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/pb-test.mjs vitest run -c vitest.backend.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:pb": "node scripts/pb-test.mjs playwright test",
    "trace": "node scripts/check-traceability.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run trace"
  },
  "dependencies": {
    "next": "^16.3.6",
    "pocketbase": "0.28.1",
    "qrcode-generator": "^2.0.4",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
