# Copy to .env.local for `npm run dev` (chmod 600). No secrets here: both values are URLs.
# Never prefix any of these with NEXT_PUBLIC_: the browser never talks to PocketBase.

# PocketBase as THIS SERVER reaches it. Read at runtime.
#   local:   http://localhost:8090 (docker compose; BACKEND_PORT if you changed it)
#   Coolify: http://plspay-pb:8090 (the backend's container name on the project network)
PB_INTERNAL_URL=http://localhost:8090

# Optional. Public origin used in payer links and to decide the Secure cookie flag.
# Defaults to the request's forwarded host. Production: https://plspay.usestack.ai
# APP_URL=https://plspay.usestack.ai
