# Copy to .env.local (chmod 600). Values come from `supabase status -o env` after `supabase start`.
# Never prefix any of these with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://127.0.0.1:6379
# Optional. Public origin used in payer links. Defaults to the request's host.
# APP_URL=https://plspay.sg
# Pilot only, used by scripts/backup.sh
# BACKUP_PASSPHRASE=
# BACKUP_REMOTE=
