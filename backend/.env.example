# Backend (PocketBase) env vars. All optional; the defaults are shown.
# Set real values in Coolify (backend app > Environment Variables), never in git.
# Comments are on their own lines on purpose: some .env parsers keep inline "# ..." as part of the value.

# settings.meta.appName; also used in backup file names
PB_APP_NAME=app
# settings.meta.appURL, e.g. https://<project>-api.usestack.ai
PB_APP_URL=
# CORS allowed origins, comma-separated, e.g. https://<project>.usestack.ai
PB_ORIGINS=*
# true only locally: admin UI schema edits then write files into pb_migrations/
PB_AUTOMIGRATE=false
# false only locally: hides the schema editing controls in the admin UI
PB_HIDE_CONTROLS=true
# header with the real client IP (Cloudflare sets it)
PB_TRUSTED_PROXY_HEADER=CF-Connecting-IP
GOMEMLIMIT=256MiB

# Backups to S3/R2, one bucket per project. Without the first four, automatic backups are off.
# e.g. pb-backup-<project>
PB_BACKUP_S3_BUCKET=
# e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PB_BACKUP_S3_ENDPOINT=
# secret
PB_BACKUP_S3_ACCESS_KEY=
# secret
PB_BACKUP_S3_SECRET=
PB_BACKUP_S3_REGION=auto
PB_BACKUP_S3_FORCE_PATH_STYLE=true
# cron is UTC: 19:00 UTC = 03:00 at UTC+8
PB_BACKUP_DAILY_CRON=0 19 * * *
PB_BACKUP_DAILY_KEEP=7
# Saturday 19:30 UTC = Sunday 03:30 at UTC+8 (keep it 30+ min away from the daily job)
PB_BACKUP_WEEKLY_CRON=30 19 * * 6
PB_BACKUP_WEEKLY_KEEP=4
# optional Uptime Kuma push URL (the full http(s):// URL), called after each successful backup
# (contains a token: treat as secret)
PB_BACKUP_HEARTBEAT_URL=
